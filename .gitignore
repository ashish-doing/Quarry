captures/
*.jpg
*.jpeg
!frontend/**/*.jpg
!frontend/**/*.jpeg
test_frame.jpg
confirm_frame.jpg

# --- Logs ---
*.log

# --- OS / editor clutter ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Node (if ever added to frontend tooling) ---
node_modules/
mobileclip_blt.ts
