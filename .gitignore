# --- Secrets, never commit these ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# --- Model weights / caches (large, and re-downloadable) ---
*.pt
*.pth
.cache/

